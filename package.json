{
  "name": "gallery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "pnpm --filter @gallery/core build && pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "start": "pnpm --filter @gallery/server run start",
    "typecheck": "pnpm --filter @gallery/core build && pnpm -r run typecheck",
    "test": "pnpm -r run test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "ffmpeg-static"
    ]
  }
}
